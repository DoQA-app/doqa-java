<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.doqa</groupId>
        <artifactId>doqa-java</artifactId>
        <version>0.1.8</version>
    </parent>

    <artifactId>doqa-cucumber</artifactId>
    <packaging>jar</packaging>

    <name>DoQA Cucumber-JVM adapter</name>
    <description>
        Cucumber-JVM plugin for DoQA: reports every scenario as an autotest with its Gherkin steps,
        hooks, attachments and Examples parameters, bound to cases by tags, either directly to the
        DoQA API or as Allure-compatible result files. Works on the JUnit Platform, JUnit 4 and
        TestNG runners of Cucumber 7 and 8.
    </description>

    <properties>
        <!-- The plugin is compiled against the oldest supported Cucumber and only uses the
             io.cucumber.plugin API, which is the same across 7.x and 8.x. The profiles below run
             the tests on the newer lines. -->
        <cucumber.version>7.0.0</cucumber.version>
        <cucumber.junit.version>5.8.1</cucumber.junit.version>
        <cucumber.testng.version>7.4.0</cucumber.testng.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${cucumber.junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>${cucumber.testng.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>app.doqa</groupId>
            <artifactId>doqa-java-commons</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- provided: the host project brings its own Cucumber. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-plugin</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Optional: the mode-0 discovery filter and the missing-plugin warning are registered
             through the JUnit Platform SPI and only load where the platform (1.8+) is present. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- JUnit 6 (Cucumber 8) needs a newer provider than the parent's surefire. -->
                <version>3.5.4</version>
                <dependencies>
                    <!-- TestNG is on the test classpath for the cucumber-testng runs; without this
                         surefire would pick its TestNG provider for the module's own tests. -->
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>3.5.4</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Only the Jupiter tests of this module run here; the features, runner
                         classes and TestNG classes under app.doqa.cucumber.e2e are launched by them. -->
                    <includes>
                        <include>app/doqa/cucumber/*Test.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <doqa.reporting>off</doqa.reporting>
                        <doqa.resultsDir>${project.build.directory}/results</doqa.resultsDir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cucumber-7-latest</id>
            <properties>
                <cucumber.version>7.34.9</cucumber.version>
                <cucumber.junit.version>5.14.2</cucumber.junit.version>
                <cucumber.testng.version>7.12.0</cucumber.testng.version>
            </properties>
        </profile>
        <!-- Cucumber 8 and JUnit 6 need Java 17. -->
        <profile>
            <id>cucumber-8</id>
            <properties>
                <cucumber.version>8.0.3</cucumber.version>
                <cucumber.junit.version>6.1.3</cucumber.junit.version>
                <cucumber.testng.version>7.12.0</cucumber.testng.version>
            </properties>
        </profile>
    </profiles>
</project>
